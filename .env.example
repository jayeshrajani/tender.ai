# Copy to .env and adjust. Never commit .env.
# All API settings use the TENDEROS_ prefix (see apps/api/app/config.py).

# --- Core -------------------------------------------------------------------
TENDEROS_ENVIRONMENT=development
# Local (no Docker): uses your OS user on localhost. Docker Compose overrides this.
TENDEROS_DATABASE_URL=postgresql+psycopg://localhost:5432/tenderos
TENDEROS_APP_URL=http://localhost:3010
# Required outside development. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TENDEROS_SIGNING_SECRET=
TENDEROS_COOKIE_SECURE=false
TENDEROS_SESSION_TTL_HOURS=168

# --- Object storage ---------------------------------------------------------
# local = files under apps/api/var/storage; s3 = MinIO / S3-compatible
TENDEROS_STORAGE_BACKEND=local
TENDEROS_S3_ENDPOINT_URL=
TENDEROS_S3_BUCKET=tenderos
TENDEROS_S3_ACCESS_KEY=
TENDEROS_S3_SECRET_KEY=
TENDEROS_MAX_UPLOAD_MB=20

# --- WhatsApp (official Meta WhatsApp Cloud API only) -------------------------
# "simulated" stores messages in the outbox and never sends.
# "live" sends ONLY when PHONE_NUMBER_ID and ACCESS_TOKEN are also set.
TENDEROS_WHATSAPP_MODE=simulated
TENDEROS_WHATSAPP_API_VERSION=v21.0
TENDEROS_WHATSAPP_PHONE_NUMBER_ID=
TENDEROS_WHATSAPP_WABA_ID=
TENDEROS_WHATSAPP_ACCESS_TOKEN=
# Used to verify X-Hub-Signature-256 on webhook callbacks
TENDEROS_WHATSAPP_APP_SECRET=
# Used for the GET webhook verification handshake
TENDEROS_WHATSAPP_VERIFY_TOKEN=
TENDEROS_WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Optional AI-assisted extraction (deterministic parsing always runs first) -
TENDEROS_AI_PROVIDER=none
TENDEROS_AI_API_KEY=

# --- DEMO seed (local development only) --------------------------------------
TENDEROS_DEMO_SEED_PASSWORD=tenderos-demo-2026

# --- Web --------------------------------------------------------------------
# Where Next.js proxies /api/* (server side). Baked in at build time.
TENDEROS_API_INTERNAL_URL=http://127.0.0.1:8010

# --- Docker Compose only -----------------------------------------------------
POSTGRES_PASSWORD=tenderos-local
MINIO_ROOT_USER=tenderos
MINIO_ROOT_PASSWORD=tenderos-local-secret
